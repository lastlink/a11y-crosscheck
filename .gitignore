reports/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local credentials for signed-in scans (A11Y_USER / A11Y_PASS)
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?

# local notes and plans, kept out of the repo (same convention as the projects this came from)
archive/
